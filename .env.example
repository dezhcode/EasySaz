# ===== ربات اصلی =====
# توکن @EasySazBot از BotFather
BOT_TOKEN=
# آیدی عددی مدیرها (از @userinfobot)، با کاما
ADMIN_IDS=

# ===== آدرس =====
# آدرس عمومی اپ با https و بدون / آخر
BASE_URL=https://dezhcode.pyho.ir/easysaz

# ===== وبهوک =====
WEBHOOK_MODE=true
# مسیر وبهوک ربات اصلی؛ بخش تصادفی داشته باشد:
#   python -c "import secrets; print('/tg/' + secrets.token_urlsafe(16))"
WEBHOOK_PATH=/tg/CHANGE_ME_RANDOM
# رمز وبهوک (رمز ربات های مشتری هم از همین مشتق می شود):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# کلید مسیرهای مدیریتی /status و /setwebhook (جدا از WEBHOOK_SECRET)
ADMIN_KEY=

# ===== رمزنگاری توکن مشتری ها =====
# یک بار بساز و هرگز عوضش نکن (عوض کردن = همه توکن ها باید دوباره فرستاده شوند):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=

# ===== دستیار هوش مصنوعی (ساخت ربات با گفتگو) =====
# کلید را از مدیر سرویس بگیر؛ خالی بماند دستیار خاموش است
EASYSAZ_AI_KEY=
EASYSAZ_AI_URL=https://dezhcode.pyho.ir
# سهم روزانهٔ دستیار: خالی = نامحدود؛ plan = سهم هر پلن
EASYSAZ_AI_LIMIT=

# ===== اختیاری =====
TG_PROXY=
TG_API_BASE=
DB_PATH=data/easysaz.db
LOG_PATH=logs/easysaz.log
LOG_LEVEL=INFO
WEBAPP_MAX_AGE=21600
